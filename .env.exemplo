# Chaves da Luna. Copie para ".env" (ou use Ajustes -> Conexoes na tela,
# que grava aqui sozinho). NUNCA versione o .env.

# IA principal (obrigatoria): entende os pedidos e conversa.
# Opcoes: deepseek | gemini | openai | groq | openrouter | assinatura (via Hermes) | ollama | outro
CEREBRO=deepseek
# CEREBRO_MODELO=          (vazio = o recomendado de cada IA)

# Chave da IA escolhida (so a dela e necessaria):
DEEPSEEK_API_KEY=COLE_SUA_CHAVE_AQUI
# GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI       https://aistudio.google.com/apikey
# OPENAI_API_KEY=COLE_SUA_CHAVE_AQUI       https://platform.openai.com/api-keys
# GROQ_API_KEY=COLE_SUA_CHAVE_AQUI         https://console.groq.com/keys
# OPENROUTER_API_KEY=COLE_SUA_CHAVE_AQUI   https://openrouter.ai/keys
# DeepSeek: https://platform.deepseek.com/api_keys . Ollama (no seu PC) nao usa chave.
# "outro": CEREBRO_URL=https://.../v1  CEREBRO_MODELO=...  CEREBRO_API_KEY=...

# Opcional: modo Expert / tarefas no PC via Claude, pelo Hermes Agent.
# No Hermes: API_SERVER_ENABLED=true no .env do perfil, e copie a
# API_SERVER_KEY de la para ca.
# HERMES_URL=http://127.0.0.1:8642/p/assistente/v1
# API_SERVER_KEY=COLE_SUA_CHAVE_AQUI

# Ouvido (onde a sua fala vira texto). Padrao: local = Whisper na placa
# de video (~2 GB, gratis, sem internet). Sem placa NVIDIA? Use a nuvem:
# groq (cota gratis, recomendado), openai ou gemini (usa a chave acima).
# STT=groq
# GROQ_API_KEY=
